{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":semanticCommits",
    ":timezone(Europe/Vienna)",
    "schedule:weekly",
  ],
  labels: ["dependencies"],
  prConcurrentLimit: 10,
  prHourlyLimit: 2,
  // Item 1: keep weekly lockfile maintenance, automerge it once required checks pass.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 5am on monday"],
    automerge: true,
  },
  vulnerabilityAlerts: { labels: ["security"] },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      // Item 1: automerge low-risk updates via GitHub native auto-merge (lands when checks pass).
      description: "Automerge low-risk updates once checks pass.",
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      automerge: true,
      platformAutomerge: true,
    },
    {
      // Item 2: group ALL GitHub Actions updates (including majors) into one PR so they do not
      // collide on the same workflow files. A group of only minor/patch/digest automerges via the
      // rule above; a group that contains a major is not automerge-eligible and waits for review.
      description: "Group all GitHub Actions updates into a single PR.",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      description: "Group non-major Python dependency updates into a single PR.",
      matchManagers: ["pep621", "pip_requirements", "pip-compile", "poetry", "setup-cfg"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "python dependencies",
    },
    {
      // Major bumps of code deps stay separate, labelled, never automerge.
      description: "Major dependency updates: separate, labelled, manual review.",
      matchManagers: ["pep621", "pip_requirements", "pip-compile", "poetry", "setup-cfg", "npm", "cargo", "gomod"],
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major-review"],
    },
  ],
}
