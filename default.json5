{
  // Single source of truth is github>rmednitzer/infra:renovate-preset.
  //
  // This repository is the purpose-named home for the shared Renovate config,
  // but the preset the fleet actually consumes has always lived in `infra`.
  // Every one of the 17 consuming repositories extends the `infra` copy; none
  // extended this one. That left this file as an unreferenced second source of
  // truth, and it drifted: it still carried `lockFileMaintenance.automerge:
  // true` after that setting was removed from the live preset, which is the
  // setting that let a lockfile refresh cross a major boundary and break nous
  // main on 2026-08-10.
  //
  // Rather than keep two copies in step by hand, this is now a thin re-export.
  // Anything that extends `github>rmednitzer/renovate-config` resolves to the
  // same config the rest of the fleet gets, and the two cannot drift again.
  // Edit the policy in `infra/renovate-preset.json`.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>rmednitzer/infra:renovate-preset"],
}
